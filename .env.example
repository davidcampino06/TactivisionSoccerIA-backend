# --- Database (Neon PostgreSQL in production) ---
# Preferred: a single URL. Neon example: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tactivision
# Still supported (current Render configuration): URL without credentials + separate variables
# NEON_DB_URL=postgresql://your-host/your-database?sslmode=require
# NEON_DB_USERNAME=your_username
# NEON_DB_PASSWORD=your_password

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120
PASSWORD_RESET_EXPIRE_MINUTES=30
# Development only (no e-mail service yet): returns the reset token in the API response
PASSWORD_RESET_EXPOSE_TOKEN=false

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tactivision-frontend.onrender.com

# --- AI Service (only the backend talks to it) ---
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_SECONDS=900
ALLOW_SIMULATION_MODE=true
# queue (default, background FIFO worker) | sync (tests)
ANALYSIS_EXECUTION=queue

# --- Video storage ---
UPLOAD_DIR=uploads
MAX_VIDEO_SIZE_MB=200

# --- Administrator account (used only by create_admin.py) ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Security (Phase 1) ---
# development | production. In production /docs is off and passwords must arrive encrypted.
ENVIRONMENT=development
# RSA key that decrypts passwords sent by the browser. Generate it with:
#   python scripts/generate_rsa_keys.py
# Without it a temporary key is used (it changes on every restart).
RSA_PRIVATE_KEY=
# Optional overrides (defaults depend on ENVIRONMENT)
# REQUIRE_ENCRYPTED_PASSWORDS=false
# ENABLE_DOCS=true
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
# PostgreSQL Row-Level Security. First apply TactiSoccerIA-db migration 0002, then set true.
DATABASE_RLS=false
